HOST=0.0.0.0
PORT=8765
DEVICE_TOKEN=REPLACE_WITH_THE_SAME_LONG_RANDOM_TOKEN_AS_FIRMWARE
WHISPER_CLI=whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin
PIPER_BIN=piper
PIPER_MODEL=/opt/piper/voices/ru_RU-irina-medium.onnx
AI_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
AI_CHAT_MODEL=local-agent
AI_CHAT_API_KEY=

# Preferred: connect directly to the existing FREEzzz AgentWebUI on the HUB.
# The gateway signs in server-side; never put this password in Cardputer firmware.
AGENTWEBUI_URL=http://127.0.0.1:3000
AGENTWEBUI_PASSWORD=SET_THE_AGENTWEBUI_LOGIN_PASSWORD_HERE
# Optional: pin a specific target, e.g. agent:YOUR_AGENT_ID or model:local/small.
# If omitted, the gateway selects the first available agent, then falls back to AGENTWEBUI_MODEL.
AGENTWEBUI_TARGET=
AGENTWEBUI_MODEL=local/small
