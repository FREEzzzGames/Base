HOST=127.0.0.1
PORT=8765
DEVICE_TOKEN=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_TOKEN

# Local Ollama chat API on FREEzzz HUB.
AI_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
AI_CHAT_MODEL=qwen3.5:4b
AI_CHAT_API_KEY=

# Speech: configure either a compatible cloud Speech API key OR local models.
# If SPEECH_API_KEY is set, it is used for both STT and TTS.
SPEECH_API_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Offline STT fallback (Whisper.cpp).
WHISPER_CLI=whisper-cli
WHISPER_MODEL=

# Offline TTS fallback (Piper).
PIPER_BIN=piper
PIPER_MODEL=
